{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    /* Strictness & Security */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Compatibility & Modules */
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Build Path */
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true
  },
  "include": ["**/*.ts"]
}
